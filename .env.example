# Copy to .env. Never commit .env. Every Azure service uses Entra ID (managed identity in Azure,
# your az login locally): there are no keys or connection strings to set.

# Model
POP_LLM=stub                   # stub (offline, default) | foundry | claude
AZURE_AI_PROJECT_ENDPOINT=     # foundry: the Foundry project endpoint
AZURE_AI_MODEL_DEPLOYMENT=     # foundry: the deployment name, e.g. gpt-4.1-mini
POP_CLAUDE_RESOURCE=           # claude: the Foundry resource name
POP_CLAUDE_DEPLOYMENT=         # claude: default claude-sonnet-5-5
POP_DEMO_CHAOS=0               # share of rewrites that gain an invented number, to show the Verifier. Never on for real viewers

# Ingest
POP_INGEST=direct              # direct (in process, default) | eventhubs
EVENTHUB_NAMESPACE=            # eventhubs: the namespace host, e.g. <name>.servicebus.windows.net

# Experiment log
COSMOS_ENDPOINT=               # blank keeps the log in memory
COSMOS_DATABASE=pop
COSMOS_CONTAINER=engagement    # engagement | loadtest | watchalong
POP_EXPERIMENT_SEED=           # server-side assignment seed. Required in Azure; keep it secret

# Broadcast
POP_ADMIN_KEY=                 # producer console key
POP_MATCH_SEED=7
POP_SPEED=1                    # match clock speed
POP_WORKERS=8                  # agent pipeline workers

# Judging mode
POP_PUBLIC_CONSOLE=            # 1 = producer console readable without the key
POP_AUTOLOOP_SPEED=            # e.g. 10 = replay matches back to back at 10x; manual start is switched off
POP_AUTOLOOP_SEEDS=7,11,23

# Limits and serving
POP_JOIN_PER_MIN=30            # joins per client address per minute
POP_ENGAGE_PER_MIN=120         # engagement events per session per minute
POP_CORS=*
POP_WEB_DIST=                  # default web/dist
